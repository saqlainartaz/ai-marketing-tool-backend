# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — NEVER commit real keys.

# --- Real AI providers (M1B) -------------------------------------------------
# From https://console.anthropic.com  (Settings -> API keys)
ANTHROPIC_API_KEY=

# From https://dashboard.voyageai.com  (free signup, 200M free tokens)
VOYAGE_API_KEY=

# Switch the engine from fake to real providers once keys are set:
ENGINE_LLM_PROVIDER=anthropic
ENGINE_EMBEDDING_PROVIDER=voyage

# --- Service auth (required to boot; any long random string) -----------------
SERVICE_API_KEY=change-me-to-a-long-random-string
